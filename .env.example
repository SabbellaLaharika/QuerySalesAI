# ==============================================================================
# AI Sales Query Agent — Environment Configuration
# ==============================================================================

# Database Connection
# SQLite connection string pointing to the sales database inside the container
DATABASE_URL=sqlite:///./data/sales.db

# ------------------------------------------------------------------------------
# LLM Provider Keys (Provide at least ONE, or leave blank to use local Ollama)
# ------------------------------------------------------------------------------

# Priority 1: Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Priority 2: Groq API Key (Free tier available at console.groq.com)
GROQ_API_KEY=

# Priority 3: NVIDIA NIM API Key (build.nvidia.com)
NVIDIA_API_KEY=

# ------------------------------------------------------------------------------
# LLM Model Configuration (Optional customization)
# ------------------------------------------------------------------------------
ANTHROPIC_MODEL=claude-haiku-4-5
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Local Ollama Configuration (Fallback when no API keys are provided)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
